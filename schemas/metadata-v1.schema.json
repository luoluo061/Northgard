{
  "$comment": "Generated from scripts/submission_contract.py; do not edit this copy alone.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "clan": {
      "anyOf": [
        {
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "consent_to_share": {
      "const": true
    },
    "data_source": {
      "enum": [
        "own_human_game"
      ]
    },
    "difficulty": {
      "anyOf": [
        {
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "experience": {
      "enum": [
        "beginner",
        "intermediate",
        "experienced",
        "expert",
        "unknown"
      ]
    },
    "feedback": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "enum": [
              "observed",
              "suspected",
              "unverified"
            ]
          },
          "counterexample": {
            "maxLength": 1200,
            "type": "string"
          },
          "game_time_seconds": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "number"
          },
          "hypothesis": {
            "maxLength": 1200,
            "type": "string"
          },
          "observation": {
            "maxLength": 1200,
            "type": "string"
          },
          "suggestion": {
            "maxLength": 1200,
            "type": "string"
          },
          "time_precision": {
            "enum": [
              "exact_game_clock",
              "sampled_interval",
              "month_phase",
              "approximate"
            ]
          },
          "unit_uids": {
            "items": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 100,
            "type": "array"
          }
        },
        "required": [
          "game_time_seconds",
          "time_precision",
          "observation",
          "hypothesis",
          "suggestion",
          "counterexample",
          "confidence"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "type": "array"
    },
    "goal": {
      "maxLength": 1200,
      "type": "string"
    },
    "map": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "seed",
        "size"
      ],
      "type": "object"
    },
    "match_link": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "declared_format": {
              "enum": [
                "3v3",
                "unknown"
              ]
            },
            "player_slot": {
              "anyOf": [
                {
                  "maximum": 3,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "shared_match_id": {
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$",
              "type": "string"
            },
            "team_label": {
              "enum": [
                "A",
                "B",
                "unknown"
              ]
            }
          },
          "required": [
            "shared_match_id",
            "declared_format",
            "team_label",
            "player_slot"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "enum": [
        "singleplayer",
        "multiplayer",
        "unknown"
      ]
    },
    "result": {
      "enum": [
        "victory",
        "defeat",
        "quit",
        "incomplete",
        "unknown"
      ]
    },
    "tags": {
      "items": {
        "pattern": "^[A-Za-z0-9_\\-\\u4e00-\\u9fff]{1,40}$",
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    }
  },
  "required": [
    "consent_to_share",
    "data_source",
    "mode",
    "clan",
    "difficulty",
    "map",
    "experience",
    "goal",
    "result",
    "tags",
    "feedback"
  ],
  "type": "object"
}
